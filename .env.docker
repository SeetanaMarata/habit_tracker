# Django settings
SECRET_KEY=your-secret-key-here-change-me-in-production
DEBUG=False

# Database settings
USE_POSTGRESQL=True

# PostgreSQL settings (для Docker)
DB_NAME=habit_tracker
DB_USER=habit_user
DB_PASSWORD=habit_password
DB_HOST=db  # ⚠️ ВАЖНО: это имя сервиса из docker-compose.yml
DB_PORT=5432

# Telegram
TELEGRAM_TOKEN=your-telegram-token-here-change-me

# Celery (Redis) - для Docker
REDIS_URL=redis://redis:6379/0  # ⚠️ ВАЖНО: redis - это имя сервиса

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1




