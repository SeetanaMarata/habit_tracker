# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database settings
# Для PostgreSQL установи USE_POSTGRESQL=True и заполни настройки ниже
USE_POSTGRESQL=False  # По умолчанию используем SQLite для разработки

# PostgreSQL settings (только если USE_POSTGRESQL=True)
DB_NAME=habit_tracker_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token

# Celery (Redis)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000